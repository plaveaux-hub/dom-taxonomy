  <!-- ================================================================
       MANAGE L2.2 — Data Security, Privacy &amp; Access Management
       ================================================================ -->

  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
       MANAGE.L2.2.L3.1 — Role-Based Data Access
       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition"/>
    <dom:sectionText>Role-Based Data Access is the capability to grant, maintain, and revoke access to data assets based on the authenticated identity and business role of the requester, enforcing the principle of least privilege across all data platforms and environments. It encompasses access policy design, role taxonomy management, provisioning and de-provisioning workflows, access certification cycles, and privileged access controls. The capability ensures that the right person can access the right data at the right time — and that inappropriate access is detected and remediated promptly.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext"/>
    <dom:sectionText>Without role-based data access controls, organisations face a twin threat: over-permissioning creates exposure to insider risk, regulatory breach, and data exfiltration, while under-permissioning creates productivity friction that drives shadow IT workarounds. Regulatory frameworks including GDPR, HIPAA, and PCI-DSS mandate demonstrable access controls as a condition of compliance. A single data breach attributable to excessive access permissions can trigger regulatory fines, reputational damage, and customer attrition that dwarf the cost of implementing proper access governance.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Data role taxonomy — hierarchical set of named roles mapping business functions to specific data access permissions across classified asset tiers</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Access provisioning and de-provisioning — automated workflows tied to HR joiner/mover/leaver events ensuring timely and accurate access lifecycle management</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Access certification — periodic review by data owners and managers confirming that each active access grant remains business-justified</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Privileged access management — elevated controls for production data access including just-in-time provisioning, session recording, and dual approval</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Access anomaly detection — continuous monitoring of access patterns to identify suspicious behaviour exceeding role norms</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_03_KeyAspects"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03_I5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Least-privilege enforcement — every user accesses only the minimum data required for their business role, minimising the blast radius of any compromise</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Regulatory compliance — demonstrable access controls satisfying GDPR Article 25 (data protection by design), HIPAA minimum necessary standard, and PCI-DSS requirement 7</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Frictionless authorised access — data consumers can access approved data without manual tickets or delays, enabling productivity and self-service analytics</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Audit-ready access logs — complete, immutable history of who accessed what data and when, available for regulatory review or incident investigation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_04_StrategicObjectives"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>GOVERN — Data Classification defines the sensitivity tiers that drive access policy design; Ownership &amp; Stewardship assigns the data owners who certify access</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>MANAGE — works alongside Data Classification &amp; Encryption to enforce access at both the identity and the data layer; feeds Breach Detection with access anomaly signals</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>BUILD — data platform provisioning scripts implement role bindings; data lake and warehouse access control lists are managed through this capability's policies</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>RUN — self-service analytics and BI product access is governed by role assignments managed through this capability; access gates protect data products at consumption layer</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_05_RelationshipToMacroProcesses"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_06_DataEconomics"/>
    <dom:sectionText>Role-based access management requires sustained investment in IAM tooling, HR system integration, and access certification process management — typically 1–3 FTE depending on scale, plus licensing for PAM and IGA platforms. The economic return is primarily risk-avoidance: the average cost of a data breach involving insider access or stolen credentials exceeds $4M (IBM 2024 figure), compared to which comprehensive access management is highly cost-effective. Efficient role management also reduces IT helpdesk ticket volume as self-service provisioning replaces manual requests.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>IN-SCOPE: Human identity access to all data stores, analytical platforms, BI tools, and data APIs across all environments (production, test, dev)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>IN-SCOPE: Service account and machine identity access for pipelines, APIs, and automated processes accessing data assets</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>IN-SCOPE: Third-party and partner access to shared data environments under contractual data sharing agreements</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>OUT-OF-SCOPE: Network and infrastructure access controls for non-data systems (governed by IT Security and CISO)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>OUT-OF-SCOPE: Application-layer access controls for transactional systems (governed by application owners and IT Security)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_07_ScopeBoundaries"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07_I5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>HR and Identity Management systems — authoritative source of employee identity, role, and employment status for joiner/mover/leaver triggers</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data Classification (MANAGE.L2.2.L3.2) — sensitivity labels on data assets determine which role tiers may access each asset</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data Ownership &amp; Stewardship (GOVERN) — data owners are the authorising decision-makers for access grants and certification sign-off</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>CISO / IT Security — provides enterprise IAM infrastructure, authentication standards, and privileged access management platform</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_08_InputSuppliersProviders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Chief Data Officer (CDO) — accountable for data access policy; escalation authority for access disputes and policy exceptions</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data Access Manager — designs role taxonomy, operates provisioning workflows, manages certification campaigns, and resolves access requests</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data Domain Owners — authorise access grants for their data assets and complete access certification reviews on a scheduled basis</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>CISO and IT Security — co-own PAM controls, provide IAM infrastructure, and conduct access-related security audits</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Data Consumers (Analysts, Data Scientists, Business Users) — end beneficiaries of access grants; their productivity and compliance are the measure of access quality</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_09_Stakeholders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09_SH5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Design and maintain the enterprise data role taxonomy aligned to job families, data classification tiers, and regulatory requirements</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Operate joiner/mover/leaver access automation: trigger provisioning and revocation from HR system events, validate completeness within 24 hours of each event</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Process access requests: receive, validate business justification, obtain data owner approval, provision access, and confirm to requester within agreed SLA</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Execute quarterly access certification: send certification tasks to data owners, track completion, revoke any access not recertified within the review window</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Monitor access anomalies: review SIEM and UEBA alerts for access pattern deviations and escalate to Data Breach Detection for investigation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</dom:itemOrder>
    <dom:itemText>Produce access audit reports for regulatory review, external audit, and internal compliance assurance on a defined schedule</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_10_Activities"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A5"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10_A6"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Identity Governance &amp; Administration (Saviynt, SailPoint, Omada) — role management, access request workflows, certification campaigns, and access analytics</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Privileged Access Management (CyberArk, BeyondTrust, HashiCorp Vault) — just-in-time elevation, session recording, and credential vaulting for production data access</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data platform native RBAC (Snowflake RBAC, Databricks Unity Catalog, BigQuery IAM) — fine-grained access enforcement at the data layer</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>SIEM / UEBA (Splunk, Microsoft Sentinel, Exabeam) — access log aggregation and behavioural anomaly detection feeding incident escalation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_11_Tools"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11_T4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Enterprise Data Role Taxonomy — approved and versioned catalogue of data roles with associated permissions per classification tier and platform</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Access provision and revocation records — complete history of all access changes with requester, authoriser, timestamp, and business justification</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Quarterly access certification reports — evidence of data owner review completion and resulting access changes per certification cycle</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Access anomaly alert log — record of all access anomalies detected, investigation outcomes, and remediation actions taken</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_12_PrimaryDeliverables"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Data Consumers (analysts, data scientists, business users) — receive timely, frictionless access to the data they need to perform their role</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data Breach Detection &amp; Incident Response (MANAGE.L2.2.L3.3) — receives access anomaly signals to trigger investigation workflows</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data Audit &amp; Certification (GOVERN) — access logs and certification evidence are primary inputs to data governance audit processes</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Regulatory Authorities — access control evidence is submitted during regulatory inspections and data protection authority audits</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_13_OutcomesConsumers"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Leaver access revocation timeliness — percentage of terminated employees with data access fully revoked within 24 hours of HR departure event</dom:itemText>
    <dom:kpiTarget>100% within 24 hours</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Access certification completion rate — percentage of access grants reviewed and confirmed or revoked within the quarterly certification window</dom:itemText>
    <dom:kpiTarget>&gt;98%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Orphaned account rate — percentage of active data access grants with no associated active HR record (service accounts excluded)</dom:itemText>
    <dom:kpiTarget>0%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Access request fulfilment SLA — percentage of access requests fulfilled within the agreed turnaround (standard 2 business days, sensitive data 5 business days)</dom:itemText>
    <dom:kpiTarget>&gt;95%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Privileged access anomaly alert rate — number of access anomaly alerts requiring investigation per month</dom:itemText>
    <dom:kpiTarget>Downward trend; &lt;5 per month at maturity</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S14_K5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>HR system integration for automated joiner/mover/leaver events — manual processes miss leavers and create orphaned accounts that become the primary insider risk vector</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data classification maturity as a prerequisite — role-based access policies can only be designed once data assets are classified; unclassified data defaults to over-permissive access</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data owner engagement in certification — access reviews delegated without follow-up result in rubber-stamp approvals that defeat the purpose of certification</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Consistent role implementation across all data platforms — access granted at the IGA layer must be enforced identically on all platforms; gaps create shadow access paths</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_15_SuccessFactors"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S15_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySpecification"/>
    <rdfs:label xml:lang="en">Specification: Role-Based Data Access</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.1_RoleBasedDataAccess"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S01"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S02"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S03"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S04"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S05"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S06"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S07"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S08"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S09"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S10"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S11"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S12"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.2_L3.1_S13"/>
