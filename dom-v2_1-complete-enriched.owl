    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_S15"/>
  </rdf:Description>

  <!-- ═══════════════════════════════════════════════════════════════════════
       RUN.L2.3 — DataOps & Platform Operations (DOM v2.1 addition)
       Operational management of data pipelines, platforms, and data products
       in production. Closes the loop between BUILD delivery and sustained
       value delivery through RUN.L2.1 and RUN.L2.2.
       ═══════════════════════════════════════════════════════════════════════ -->

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L2Capability" />
    <rdfs:label xml:lang="en">DataOps &amp; Platform Operations</rdfs:label>
    <rdfs:label xml:lang="fr">DataOps et Opérations de Plateforme</rdfs:label>
    <skos:definition xml:lang="en">Ensures continuous, reliable, and cost-efficient operation of data pipelines, platforms, and data products in production. Encompasses monitoring, incident management, capacity planning, DataOps practices, and FinOps for data infrastructure. The operational backbone that sustains the value delivered by RUN.L2.1 and RUN.L2.2.</skos:definition>
    <dom:capabilityId>RUN.L2.3</dom:capabilityId>
    <dom:l3Count rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</dom:l3Count>
    <dom:bookChapter>Chapter 3.6 / Annex VI</dom:bookChapter>
    <dom:belongsToMacroProcess rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN" />
    <dom:monitors rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_DataTransport" />
    <dom:monitors rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_DataProvisioning" />
    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_DataServiceLevelManagement" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.1_DataPipelineOperationsMonitoring" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.2_DataPlatformObservability" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.3_DataIncidentManagement" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.4_DataInfrastructureCapacityPlanning" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.5_DataProductLifecycleOperations" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.6_DataFinOpsCloudCostManagement" />
  </rdf:Description>

  <!-- L3.1 — Data Pipeline Operations & Monitoring -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.1_DataPipelineOperationsMonitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Pipeline Operations &amp; Monitoring</rdfs:label>
    <rdfs:label xml:lang="fr">Opérations et Surveillance des Pipelines de Données</rdfs:label>
    <skos:definition xml:lang="en">Day-to-day operation and monitoring of data ingestion, transformation, and delivery pipelines. Includes scheduling, failure detection, alerting, restart management, and DataOps automation practices (CI/CD for data). Ensures pipelines run reliably within agreed SLAs.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.1</dom:capabilityId>
    <dom:ppsdDimension>system</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_DataTransport" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.1_SLADefinitionMonitoring" />
  </rdf:Description>

  <!-- L3.2 — Data Platform Observability -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.2_DataPlatformObservability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Platform Observability</rdfs:label>
    <rdfs:label xml:lang="fr">Observabilité de la Plateforme de Données</rdfs:label>
    <skos:definition xml:lang="en">End-to-end visibility into the health, freshness, volume, schema, and distribution of data across the platform. Encompasses data quality monitoring in production (data observability tools such as Monte Carlo, Bigeye, or Soda), lineage-based impact analysis for anomalies, and automated data freshness alerting. Distinct from BUILD-time testing.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.2</dom:capabilityId>
    <dom:ppsdDimension>system</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_L3.2_DataQualityManagement" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.3_L3.4_DataLineageImpactAnalysis" />
  </rdf:Description>

  <!-- L3.3 — Data Incident Management -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.3_DataIncidentManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Incident Management</rdfs:label>
    <rdfs:label xml:lang="fr">Gestion des Incidents Data</rdfs:label>
    <skos:definition xml:lang="en">Structured response to data incidents in production: pipeline failures, data quality breaches, latency violations, and data loss events. Covers triage, escalation, root-cause analysis, remediation, post-mortem, and prevention. Aligns with ITIL incident management practices adapted for data-intensive systems and integrates with MANAGE_L2.2 for security incidents.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.3</dom:capabilityId>
    <dom:ppsdDimension>process</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.3_DataBreachDetectionIncidentResponse" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.2_BusinessContinuityDisasterRecovery" />
  </rdf:Description>

  <!-- L3.4 — Data Infrastructure Capacity Planning -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.4_DataInfrastructureCapacityPlanning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Infrastructure Capacity Planning</rdfs:label>
    <rdfs:label xml:lang="fr">Planification de la Capacité Infrastructurelle Data</rdfs:label>
    <skos:definition xml:lang="en">Forward-looking management of compute, storage, and network capacity for data workloads. Includes demand forecasting, resource reservation, auto-scaling policies, tier management (hot/warm/cold storage), and infrastructure lifecycle decisions. Prevents capacity-induced outages while avoiding over-provisioning and associated FinOps waste.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.4</dom:capabilityId>
    <dom:ppsdDimension>system</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.3_PortfolioManagementDemandPrioritization" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.6_DataFinOpsCloudCostManagement" />
  </rdf:Description>

  <!-- L3.5 — Data Product Lifecycle Operations -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.5_DataProductLifecycleOperations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Product Lifecycle Operations</rdfs:label>
    <rdfs:label xml:lang="fr">Opérations du Cycle de Vie des Produits Data</rdfs:label>
    <skos:definition xml:lang="en">End-to-end operational management of data products through their lifecycle: launch, version management, deprecation, and decommissioning. Includes managing data product SLAs, consumer notification, backward compatibility, and the DataContract enforcement between producers and consumers. Operationalises the Data Mesh product ownership principle in production.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.5</dom:capabilityId>
    <dom:ppsdDimension>process</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.3_DataProductCatalogueDiscoverability" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_L3.4_DataRetentionArchivalDeletion" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.1_SLADefinitionMonitoring" />
  </rdf:Description>

  <!-- L3.6 — Data FinOps & Cloud Cost Management -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.6_DataFinOpsCloudCostManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data FinOps &amp; Cloud Cost Management</rdfs:label>
    <rdfs:label xml:lang="fr">FinOps Data et Gestion des Coûts Cloud</rdfs:label>
    <skos:definition xml:lang="en">Continuous monitoring, allocation, and optimisation of cloud and on-premises data infrastructure costs. Covers per-workload cost attribution (chargeback to BU or data product), query cost optimization (BigQuery slot management, Redshift concurrency), storage tier management, LLM inference cost governance, and unit-economics dashboards for data products. The operational complement to MANAGE_L2.1 economic governance.</skos:definition>
    <dom:capabilityId>RUN.L2.3.L3.6</dom:capabilityId>
    <dom:ppsdDimension>process</dom:ppsdDimension>
    <dom:typicalMaturityEntry rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:typicalMaturityEntry>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_DataOpsplatformOperations" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.2_CostAccountingChargeback" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.5_EconomicPerformanceReporting" />
    <dom:relatedTo rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.4_DataInfrastructureCapacityPlanning" />
  </rdf:Description>



  <!-- ═══════════════════════════════════════════════════
       Specification: Data Pipeline Operations & Monitoring (RUN.L2.3.L3.1)
       ═══════════════════════════════════════════════════ -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S01">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition" />
    <dom:sectionText xml:lang="en">Data Pipeline Operations &amp; Monitoring is the capability to ensure the continuous, reliable execution of data ingestion, transformation, and delivery pipelines in production environments. It encompasses job scheduling, failure detection, automated alerting, restart and recovery management, and the application of DataOps CI/CD automation practices to pipeline deployment. This capability acts as the operational heartbeat of the data platform, translating BUILD-delivered pipelines into sustained, SLA-compliant data flows that business and analytical consumers depend upon.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S02">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext" />
    <dom:sectionText xml:lang="en">Without structured pipeline operations, data failures go undetected until business users report missing or stale reports — by which time downstream decisions have already been compromised. Ad hoc monitoring based on manual checks creates unacceptable mean-time-to-detect (MTTD) values and transforms data engineering teams into reactive firefighters rather than value-generating builders. The absence of CI/CD automation for pipelines further compounds instability, as manual deployments introduce human error into every release.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Job scheduling &amp; orchestration — coordinating pipeline execution sequences, dependencies, and timing across batch and near-real-time workloads using workflow orchestrators</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Failure detection &amp; automated alerting — real-time monitoring of pipeline health with threshold-based and anomaly-based alerting routed to on-call teams</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Restart &amp; recovery management — automated and supervised pipeline recovery procedures minimising data loss and re-processing scope after failures</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">CI/CD for data pipelines — automated testing, validation, and deployment of pipeline code changes following DataOps engineering practices</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">SLA compliance tracking — measurement of pipeline execution against agreed latency, freshness, and completeness SLAs, with escalation on breach</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_03_KeyAspects" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I4" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S03_I5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Reliable data delivery — ensuring all downstream consumers receive fresh, complete data within contracted SLA windows, eliminating confidence-eroding data latency</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Reduced operational toil — automating failure detection and recovery to free data engineers from manual monitoring and incident triage</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Deployment safety — applying CI/CD discipline to pipeline changes, reducing production incidents caused by manual deployment errors</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Operational transparency — providing stakeholders with real-time visibility into pipeline health and SLA performance through operational dashboards</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_04_StrategicObjectives" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S04_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">GOVERN — Data Strategy defines the reliability and freshness standards that pipeline operations must achieve; policies set acceptable SLA breach response procedures</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">MANAGE — SLA Definition &amp; Monitoring (MANAGE.L2.5.L3.1) provides the contractual SLA targets; Incident Management workflows integrate with MANAGE.L2.2 for data breach escalation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">BUILD — Data Transport (BUILD.L2.1) delivers the pipeline code and infrastructure that this capability operates; deployment gates enforce BUILD quality standards</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">RUN — feeds observability telemetry into Data Platform Observability (L2.3.L3.2) and incident records into Data Incident Management (L2.3.L3.3); SLA data flows to MANAGE.L2.5</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_05_RelationshipToMacroProcesses" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S05_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S06">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_06_DataEconomics" />
    <dom:sectionText xml:lang="en">Pipeline operations tooling (Airflow, Prefect, Dagster, Monte Carlo for pipeline health) represents significant recurring investment, but the cost of unmonitored pipeline failure — in remediation effort, stale-data decisions, and business trust erosion — consistently exceeds tool subscription costs by an order of magnitude. Mature DataOps automation reduces mean-time-to-recover (MTTR) from hours to minutes, with measurable impact on data team capacity available for value-generating work.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: Monitoring, alerting, scheduling, and recovery operations for data ingestion, transformation, and delivery pipelines in production</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: CI/CD automation for pipeline code deployment, including automated testing gates and environment promotion</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: SLA compliance tracking and escalation for pipeline latency and freshness breaches</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">OUT-OF-SCOPE: Pipeline design, architecture, and initial BUILD — these are managed in BUILD.L2.1 (Data Transport)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">OUT-OF-SCOPE: Data quality validation logic and business rule implementation — these belong to MANAGE.L2.4 and are executed as pipeline steps</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S07">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
