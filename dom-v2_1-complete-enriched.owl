    <rdfs:label xml:lang="en">Specification: Generative AI &amp; LLM Applications</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_L3.3_GenerativeAILLMApplications"/>
