  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <rdfs:label xml:lang="en">Data Operating Model (DOM) Core Ontology</rdfs:label>
    <rdfs:label xml:lang="fr">Ontologie Core du Data Operating Model (DOM)</rdfs:label>
    <rdfs:comment xml:lang="en">Formal ontology for the Data Operating Model (DOM) framework v2.0.
The DOM treats each data capability as an enterprise subsystem balanced across
4 orthogonal dimensions (People, Process, Systems, Data) and organized in a
hierarchical structure: 4 Macro-Processes (L0) → 13 L2 Capabilities → 63 L3 Sub-Capabilities.

This Phase 1 ontology establishes the core taxonomy aligned with the Full DOM book.
Subsequent phases will add: Dimensions &amp; 15-Section structure (Phase 2),
Organizational instantiation layer (Phase 3), Stakeholders &amp; RACI (Phase 4),
Framework Integration &amp; KPIs (Phase 5).</rdfs:comment>
    <dcterms:title xml:lang="en">DOM Core Ontology v2.0</dcterms:title>
    <dcterms:creator>Pascal Laveaux</dcterms:creator>
    <dcterms:publisher>Strategic Advisory</dcterms:publisher>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-10</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-13</dcterms:modified>
    <dcterms:rights>Copyright (c) 2026 Pascal Laveaux. All rights reserved.</dcterms:rights>
    <dcterms:license>Proprietary</dcterms:license>
    <owl:versionInfo>2.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="http://strategic-advisory.com/ontology/dom/2.1.0" />
    <owl:priorVersion rdf:resource="http://strategic-advisory.com/ontology/dom/1.0" />
    <skos:changeNote xml:lang="en">v2.0: Complete realignment with Full DOM book. Restructured from 59 to 63 L3. Stabilized L2 hierarchy under 4 macro-processes. Clean URI scheme for extensibility.</skos:changeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RETAIL_A_DQ_Sys">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DimensionalAssessment" />
    <dom:assessesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_L3.2_DataQualityManagement" />
    <dom:assessedOnDimension rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Systems" />
    <dom:maturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:maturityScore>
    <dom:targetMaturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:targetMaturityScore>
    <dom:assessmentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-31</dom:assessmentDate>
    <dom:assessmentNotes>dbt + Great Expectations. Tools are modern, processes aren't.</dom:assessmentNotes>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.2_CostAccountingChargeback">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
