    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Report portfolio SLA attainment — percentage of scheduled reports delivered within committed freshness window</dom:itemText>
    <dom:kpiTarget>>95%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Metric consistency rate — percentage of enterprise KPIs with identical definitions across all reports consuming them</dom:itemText>
    <dom:kpiTarget>100%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Report quality gate pass rate — percentage of report runs passing all pre-publication quality checks without suppression</dom:itemText>
    <dom:kpiTarget>&gt;98%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Shadow report reduction — percentage reduction in business-unit maintained spreadsheet reporting in annual audit</dom:itemText>
    <dom:kpiTarget>Year-on-year improvement &gt;20%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Consumer satisfaction score — percentage of report consumers rating accuracy and timeliness as acceptable or above</dom:itemText>
    <dom:kpiTarget>&gt;85%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S14_K5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Semantic layer is the foundation of metric consistency — reports built directly on warehouse tables without a shared metric layer will diverge</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Report retirement is as important as report creation — ungoverned report portfolios grow without bound; retirement must match commissioning in rigour</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Quality gates before delivery — suppressing a report and alerting consumers is always better than delivering incorrect data silently</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Consumer requirements must drive design — BI teams that build reports without iterative business validation build reports that are not used</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_15_SuccessFactors"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S15_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySpecification"/>
    <rdfs:label xml:lang="en">Specification: Business Intelligence &amp; Reporting Delivery</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.1_BusinessIntelligenceReportingDelivery"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S01"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S02"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S03"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S04"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S05"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S06"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S07"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S08"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S09"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S10"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S11"/>
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.1_L3.1_S12"/>
