  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition"/>
    <dom:textContent>Defines how the data function is structured, how accountability is distributed across the organisation, and which operating model (centralised, federated, hybrid) best serves the enterprise data ambition and business context. Determines the organisational architecture within which all data capabilities are exercised.</dom:textContent>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext"/>
    <dom:textContent>Operating model ambiguity is one of the most disruptive failure modes in data management — when it is unclear who owns data decisions, who funds data capabilities, and who is accountable for data outcomes, every programme becomes a negotiation. The wrong operating model creates permanent friction: over-centralisation stifles agility while under-centralisation creates inconsistency and duplication.</dom:textContent>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Operating Model Architecture — Design of the centralised, federated, or hybrid model with explicit accountability assignments per data domain</dom:itemText>
    <dom:relatedDimension>Process</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data Function Organisational Design — Structuring the central data office: roles, reporting lines, team sizes, and competency profiles</dom:itemText>
    <dom:relatedDimension>People</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Domain Ownership Model — Assignment of data domain ownership to business units with clear responsibilities and CDO oversight</dom:itemText>
    <dom:relatedDimension>People</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Operating Model Governance — Decision rights, escalation paths, and conflict resolution between central and domain teams</dom:itemText>
    <dom:relatedDimension>Process</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Organisational Change Management — Managing the cultural and structural transition to the target operating model</dom:itemText>
    <dom:relatedDimension>People</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
