    <rdfs:label xml:lang="en">Coverage Asymmetry</rdfs:label>
    <skos:definition xml:lang="en">Federated L3 where domain maturity varies by more than 2 levels.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#contributesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">contributes to</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPI" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPI" />
    <rdfs:comment xml:lang="en">Inverse of decomposesInto: this KPI contributes to a higher-tier KPI.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#decomposesInto" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#assignmentNotes">
