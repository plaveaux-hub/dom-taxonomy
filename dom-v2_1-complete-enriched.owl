  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">BUILD.L2.1 Data Transport — delivers production-ready pipeline code, infrastructure-as-code, and deployment artefacts for operational management</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">MANAGE.L2.5.L3.1 SLA Definition &amp; Monitoring — provides the contractual SLA targets and escalation thresholds against which pipeline performance is measured</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Platform team — engineers on-call responsible for responding to alerts, executing recovery procedures, and managing deployment gates</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Source system teams — provide availability windows, maintenance schedules, and change notifications affecting upstream pipeline dependencies</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
