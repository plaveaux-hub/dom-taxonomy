    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Pipeline estate inventory — catalogued list of all production pipelines with owner, schedule, and SLA</dom:itemText>
  </rdf:Description>
