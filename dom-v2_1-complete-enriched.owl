    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
