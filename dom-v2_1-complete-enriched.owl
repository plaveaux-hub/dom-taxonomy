    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Architecture Evolution Management — Structured approach to evolving enterprise architecture as business and technology change</dom:itemText>
    <dom:relatedDimension>Process</dom:relatedDimension>
  </rdf:Description>
