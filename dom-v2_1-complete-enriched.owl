    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S10_A3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S10_A4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S10_A5"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S10_A6"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S11_T1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>spaCy, Transformers (Hugging Face), OpenAI API, Azure AI Language — NLP model development and text processing</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S11_T2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Document AI platforms (AWS Textract, Google Document AI, Azure Form Recognizer) — intelligent document processing and form extraction</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S11_T3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Conversational AI platforms (Dialogflow, Microsoft Bot Framework, Rasa, custom LLM-powered dialogue systems) — chatbot and dialogue management</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S11_T4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>NLP monitoring (custom dashboards, Evidently AI for text model drift) — production NLP model performance and conversational quality tracking</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.2_L3.2_S11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
