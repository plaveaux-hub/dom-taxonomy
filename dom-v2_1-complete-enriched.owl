  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#assignmentDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">assignment date</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilityAssignment" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
