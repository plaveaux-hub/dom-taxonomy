    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Scraped data asset library — extracted, structured datasets from approved web sources with provenance metadata</dom:itemText>
