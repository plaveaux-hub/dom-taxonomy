    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Platform Observability (L2.3.L3.2) — primary incident trigger source, providing anomaly detection alerts with lineage impact analysis and severity context</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Pipeline Operations &amp; Monitoring (L2.3.L3.1) — provides pipeline failure alerts, SLA breach notifications, and execution logs required for initial triage and RCA</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">MANAGE.L2.2.L3.3 Data Breach Detection — provides security incident context for incidents with regulatory implications; coordinates escalation to DPO</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Data consumers (BI, Analytics, Operations) — report data incidents not detected by automated monitoring; provide business impact assessment inputs during triage</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_08_InputSuppliersProviders" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Incident Commander (on-call Lead Data Engineer) — owns incident response lifecycle from detection through resolution and post-mortem; coordinates all response activities</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Pipeline Engineers — execute technical investigation and remediation; perform backfill operations and emergency hotfix deployment</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Product Owner — provides business context for impact assessment; approves remediation scope and communicates status to data consumers</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Steward (MANAGE) — engaged for incidents with data integrity implications; assesses downstream catalogue and lineage impact; coordinates stewardship response</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">CDO / Data Governance Lead — engaged for P1 incidents; approves regulatory escalation; receives executive incident summary and post-mortem outcomes</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_09_Stakeholders" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I4" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09_I5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Detect and classify incidents: receive alerts from observability and pipeline monitoring tools; apply severity classification framework and initiate appropriate response level</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Assemble and coordinate response: activate incident response team based on severity; establish communication bridge and assign investigation workstreams</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Investigate root cause: analyse pipeline logs, observability data, and lineage traces to identify the origin and propagation path of the incident</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Remediate and restore service: execute data backfill, re-processing, or correction procedures; validate data completeness and accuracy before closing consumer impact notification</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">Communicate incident status: provide structured status updates to data consumers and stakeholders throughout the incident lifecycle using predefined communication templates</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I6">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</dom:itemOrder>
    <dom:itemText xml:lang="en">Conduct post-mortem: facilitate blameless post-mortem within 48 hours of P1/P2 resolution; document timeline, root cause, contributing factors, and preventive action items</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_10_Activities" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I4" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I5" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10_I6" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">PagerDuty, Opsgenie — on-call alerting, incident routing, and escalation management with severity-based notification policies and on-call schedule management</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Jira Service Management, ServiceNow, Linear — incident ticket creation, workflow management, RCA documentation, and preventive action tracking</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Slack, Microsoft Teams — incident communication channels with dedicated incident bridge channels, status update automation, and stakeholder notification bots</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Confluence, Notion — post-mortem documentation, runbook storage, and incident knowledge base enabling learning retention and recurrence prevention</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_11_Tools" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Incident register — structured log of all data incidents with severity, detection time, MTTR, root cause category, and consumer impact assessment</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Post-mortem reports — blameless post-mortem documents for P1/P2 incidents including timeline, root cause analysis, contributing factors, and corrective action items</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Consumer impact communications — structured incident notifications and status updates sent to affected data consumers throughout the incident lifecycle</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Incident trend analysis — monthly report of incident frequency by category, MTTR trends, repeat incident rates, and preventive action completion status</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_12_PrimaryDeliverables" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Data consumers (BI, Analytics, Operations) — receive structured incident communications, minimising decision disruption and enabling informed workaround planning</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Continuous Service Improvement (MANAGE.L2.5.L3.4) — receives post-mortem outputs as improvement backlog items driving reliability maturity progression</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">MANAGE.L2.2 Data Security — receives incident records with regulatory exposure assessment to coordinate DPO notification and breach reporting timelines</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Platform Observability (L2.3.L3.2) — receives incident learnings to improve monitoring thresholds and close detection gaps revealed during investigation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_13_OutcomesConsumers" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Mean Time to Recover (MTTR) for P1 incidents — average time from P1 incident declaration to confirmed data service restoration</dom:itemText>
    <dom:kpiTarget xml:lang="en">&lt;4 hours</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Mean Time to Recover (MTTR) for P2 incidents — average time from P2 incident declaration to confirmed resolution</dom:itemText>
    <dom:kpiTarget xml:lang="en">&lt;24 hours</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Post-mortem completion rate — percentage of P1 and P2 incidents receiving completed post-mortem within 48 hours of resolution</dom:itemText>
    <dom:kpiTarget xml:lang="en">&gt;95%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Repeat incident rate — percentage of incidents in the same root-cause category as a prior incident within the last 90 days</dom:itemText>
    <dom:kpiTarget xml:lang="en">&lt;15%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">Preventive action closure rate — percentage of post-mortem corrective actions completed within committed timelines</dom:itemText>
    <dom:kpiTarget xml:lang="en">&gt;80%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I4" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14_I5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Blameless culture is the foundation — post-mortems that assign personal blame produce cover-up behaviour and suppress honest reporting; psychological safety is a prerequisite for effective incident learning</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Severity classification must be pre-agreed — severity criteria defined in advance prevent debates during incidents; agreed P1–P4 definitions with business impact thresholds must exist before the first incident</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Post-mortem action tracking closes the loop — a post-mortem without tracked, owned corrective actions is an expensive documentation exercise; improvement must be verifiable</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Communication templates reduce cognitive load under pressure — pre-written incident communication templates enable clear, consistent consumer notification even when responders are under time pressure</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_15_SuccessFactors" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S15_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySpecification" />
    <rdfs:label xml:lang="en">Specification: Data Incident Management</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.3_L3.3_DataIncidentManagement" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S01" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S02" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S06" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S08" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S09" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S10" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S11" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S12" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S13" />
    <dom:hasSectionContent rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S14" />
