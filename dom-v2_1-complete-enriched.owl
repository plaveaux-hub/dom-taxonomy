  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_06_DataEconomics"/>
    <dom:textContent>Operating model decisions have the highest organisational leverage of any design choice — the wrong model costs 15-25% of the total data programme budget annually in duplicated effort, misaligned priorities, and governance overhead. Conversely, a well-designed operating model reduces time-to-decision by 40-60% and significantly improves data programme delivery velocity.</dom:textContent>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S07_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>IN: Enterprise data operating model design and documentation</dom:itemText>
    <dom:scopeType>in-scope</dom:scopeType>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S07_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>IN: CDO mandate and data function organisational structure</dom:itemText>
    <dom:scopeType>in-scope</dom:scopeType>
  </rdf:Description>
