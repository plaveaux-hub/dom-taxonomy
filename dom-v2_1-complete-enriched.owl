    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S07_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S07_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S07_I4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S07_I5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Business Glossary (MANAGE.L2.3.L3.3) — informal business definitions elevated to formal semantic model terms</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data Modelling (MANAGE.L2.3.L3.2) — logical entity models translated into formal ontological representations</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Domain experts and knowledge engineers — subject matter expertise required to validate concept definitions and relationship semantics</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Industry ontology working groups — external sources for standard ontologies (W3C, HL7, ISDA, SWIFT) that must be incorporated</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_08_InputSuppliersProviders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S08_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Chief Data Officer (CDO) — sponsors semantic model programme as a strategic AI and analytics enabler</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Knowledge Engineer / Ontologist — designs and maintains enterprise ontologies and taxonomies; manages vocabulary governance process</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data Architects — translate logical data models into formal semantic representations; ensure semantic layer alignment with physical models</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>AI and Analytics teams — primary consumers of semantic models for knowledge graph applications, LLM grounding, and semantic search</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Domain subject matter experts — validate concept definitions, relationship correctness, and classification criteria</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_09_Stakeholders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S09_SH5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Design and maintain the enterprise ontology: model key business concepts, their properties, and relationships in OWL/SKOS; version and publish to the semantic registry</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Manage taxonomy lifecycle: add, deprecate, and reorganise taxonomy nodes through a governed change process with impact analysis on downstream consumers</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Maintain controlled vocabularies: govern approved term sets for all classification and tagging systems; manage synonym mappings and term disambiguation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Operate and maintain the analytics semantic layer: ensure business metric definitions remain consistent with logical models and business glossary</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Integrate semantic models into consuming systems: support BUILD teams in connecting knowledge graphs, search indexes, and LLM systems to maintained ontologies</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_10_Activities"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S10_A5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Ontology and knowledge graph platforms (TopBraid EDG, Stardog, Neptune, Neo4j) — ontology authoring, storage, querying, and publishing</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Semantic layer tools (dbt Semantic Layer, AtScale, Cube.js) — centralised metric definitions consumed consistently across BI tools</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Taxonomy management tools (Synaptica, Smartlogic, PoolParty) — taxonomy governance, versioning, and vocabulary management</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Standard ontology libraries and repositories (BioPortal, LOV, FIBO Portal) — source and reference for industry standard ontologies</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_11_Tools"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S11_T4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Enterprise ontology — published, versioned OWL/SKOS ontology covering core business domains, queryable via SPARQL</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Enterprise taxonomy registry — governed hierarchical classification structures for all major classification domains with change history</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Analytics semantic layer — centralised metric and dimension definitions consumed by all approved BI and analytics tools</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Industry standard mapping document — alignment of enterprise ontology concepts to relevant industry standards (HL7, FIBO, schema.org)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_12_PrimaryDeliverables"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S12_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>AI and analytics platform teams — consume ontologies and knowledge graphs as the structured knowledge foundation for intelligent applications</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Enterprise search and information retrieval (RUN) — semantic models provide the concept graph enabling conceptual search beyond keyword matching</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Data catalogue (MANAGE.L2.3.L3.3) — semantic tags and classifications applied to assets using governed taxonomies</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Regulatory reporting systems — industry-compliant semantic representations required for structured regulatory data submissions</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_13_OutcomesConsumers"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S13_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Enterprise ontology coverage — percentage of core business domains represented in the formal enterprise ontology</dom:itemText>
    <dom:kpiTarget>>70%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Taxonomy governance adherence — percentage of taxonomy changes made through the governed change process (vs. direct system changes)</dom:itemText>
    <dom:kpiTarget>100%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Semantic layer metric coverage — percentage of core enterprise KPIs defined in the analytics semantic layer</dom:itemText>
    <dom:kpiTarget>>85%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Ontology alignment with industry standards — percentage of relevant industry standard concepts mapped to enterprise ontology</dom:itemText>
    <dom:kpiTarget>&gt;80%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Consuming application adoption — number of applications actively consuming enterprise ontology or semantic layer</dom:itemText>
    <dom:kpiTarget>Year-on-year growth &gt;20%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S14_K5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Start with taxonomy before ontology — hierarchical classification is more immediately useful and easier to govern than full ontologies; build semantic sophistication incrementally</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Semantic layer before knowledge graph — the analytics semantic layer delivers immediate, measurable ROI by eliminating metric discrepancies; knowledge graphs are a longer-term investment</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Domain expert validation at every level — semantic models that are technically correct but semantically wrong from a business perspective are rejected by consumers</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Integration with consuming applications — ontologies that exist in isolation without integration into search, AI, or BI systems generate no return on their design investment</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_15_SuccessFactors"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.3_L3.5_S15_I4"/>
  </rdf:Description>
