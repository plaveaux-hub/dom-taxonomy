    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S13_I4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Legal compliance rate — percentage of active scraping pipelines with current, approved legal review</dom:itemText>
    <dom:kpiTarget>100%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Extraction completeness — percentage of expected records successfully extracted per scraping run</dom:itemText>
    <dom:kpiTarget>&gt;95%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Change detection response time — average time from site structure change detection to adapted pipeline deployment</dom:itemText>
    <dom:kpiTarget>&lt;2 business days</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>ToS violation incidents — number of cease-and-desist or ToS violation notifications received per year</dom:itemText>
    <dom:kpiTarget>0</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Annual compliance review coverage — percentage of active engagements reviewed for continued legal permissibility within 12 months</dom:itemText>
    <dom:kpiTarget>100%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S14_K5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S15_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Legal review before every new engagement — ToS change; annual review is a minimum requirement</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S15_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Respect is non-negotiable — aggressive scraping disrupting target sites creates legal and reputational risk</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S15_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Change detection is the operational Achilles heel — scraping pipelines break silently on site changes; automated detection is essential</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S15_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Catalogue with provenance — scraped data in models without documented source attribution creates IP risk that cannot be managed after the fact</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_BUILD_L2.1_L3.6_S15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
