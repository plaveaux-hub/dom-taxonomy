    <dom:assessesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.3_BatchDataTransferProcessing" />
    <dom:assessedOnDimension rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Systems" />
    <dom:maturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:maturityScore>
    <dom:targetMaturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:targetMaturityScore>
    <dom:assessmentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-31</dom:assessmentDate>
    <dom:assessmentNotes>Fivetran + dbt. 200+ connectors. Self-healing pipelines.</dom:assessmentNotes>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BANK_A_Strategy_People">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DimensionalAssessment" />
    <dom:assessesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.1_L3.1_DataStrategyCommunication" />
    <dom:assessedOnDimension rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#People" />
    <dom:maturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:maturityScore>
    <dom:targetMaturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:targetMaturityScore>
    <dom:assessmentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-31</dom:assessmentDate>
    <dom:assessmentNotes>CDO competent but politically isolated. No dedicated strategy team.</dom:assessmentNotes>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#HybridStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Hybrid Strategy Pattern</rdfs:label>
    <rdfs:comment xml:lang="en">A recommended framework combination pattern from DOM Chapter 4.2.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#FrameworkIntensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Framework Intensity</rdfs:label>
    <rdfs:comment xml:lang="en">Intensity level of a framework's demand on a DOM capability.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Capability Specification</rdfs:label>
    <rdfs:label xml:lang="fr">Specification de Capability</rdfs:label>
    <rdfs:comment xml:lang="en">A reified container representing the complete 15-section specification
of a single L3 sub-capability. Each L3 has exactly one CapabilitySpecification.
The specification contains SectionContent instances for each of the 15 sections.

This design enables:
  - SPARQL queries across all sections of all capabilities
  - Content search (e.g. 'which L3 mentions Data Steward in Activities?')
  - Structured data extraction for tooling (RACI, KPI tracker, etc.)
  - Progressive population (start with Section 1, add others over time)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#assessmentScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">assessment scope</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DimensionalAssessment" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OrganizationalUnit" />
    <rdfs:comment xml:lang="en">The organizational unit this assessment applies to. If absent, assessment is enterprise-wide. (Phase 3 will populate OrganizationalUnit instances.)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#tierAudience">
