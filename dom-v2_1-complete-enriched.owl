    <rdfs:comment xml:lang="en">The text content of a structured item.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BANK_Risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
