  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MacroProcess" />
    <rdfs:label xml:lang="en">BUILD</rdfs:label>
    <rdfs:label xml:lang="fr">CONSTRUIRE</rdfs:label>
    <skos:definition xml:lang="en">Construct Platforms &amp; Data Flows. Constructs the technical platforms and data flows that MANAGE controls and RUN delivers through. 60-70% of capacity is demand-driven by MANAGE Portfolio Management; 30-40% addresses technical debt, platform evolution, and innovation.</skos:definition>
    <dom:capabilityId>L0.BUILD</dom:capabilityId>
    <dom:l3Count rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</dom:l3Count>
    <dom:bookChapter>Chapter 3.3</dom:bookChapter>
    <dom:hasL2Capability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_DataTransport" />
