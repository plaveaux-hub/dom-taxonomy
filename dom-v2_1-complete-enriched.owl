  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#PersonAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Person Assignment</rdfs:label>
    <rdfs:label xml:lang="fr">Affectation de Personne</rdfs:label>
    <rdfs:comment xml:lang="en">Maps a real person in the organization to a DOM stakeholder role type
within an organizational unit. Supports:
  - One person → multiple roles (common in smaller organizations)
  - One role → unassigned (vacancy detection)
  - Temporal tracking (assignment start/end dates)</rdfs:comment>
  </rdf:Description>
