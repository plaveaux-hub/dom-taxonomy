    <dom:consumerCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_DataEconomicsPerformance" />
    <dom:valueChainOutput>Quality metrics calibrating asset valuation</dom:valueChainOutput>
    <dom:chainStrength>important</dom:chainStrength>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#gapSeverity">
