    <dom:referencesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.2_DataGovernanceOversight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S13_OC2">
