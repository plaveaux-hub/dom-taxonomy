  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_DataServiceLevelManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L2Capability" />
    <rdfs:label xml:lang="en">Data Operations &amp; Reliability</rdfs:label>
    <rdfs:label xml:lang="fr">Operations Data &amp; Fiabilite</rdfs:label>
    <skos:definition xml:lang="en">Ensures data capabilities deliver agreed performance, availability, and quality through SLA definition, operational monitoring, business continuity, and continuous improvement. Brings operational discipline and reliability engineering to the data function.</skos:definition>
    <dom:capabilityId>MANAGE.L2.5</dom:capabilityId>
    <dom:l3Count rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:l3Count>
    <dom:bookChapter>Chapter 3.2 / Annex II</dom:bookChapter>
    <dom:belongsToMacroProcess rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE" />
    <dom:monitors rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_DataTransport" />
    <dom:monitors rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_DataProvisioning" />
    <dom:monitors rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.1_DataStrategyDirection" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.1_SLADefinitionMonitoring" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.2_BusinessContinuityDisasterRecovery" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.3_ServicePerformanceReporting" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.4_ContinuousServiceImprovement" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#FW_DataMesh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Framework" />
    <rdfs:label xml:lang="en">Data Mesh</rdfs:label>
    <dom:frameworkOrigin>ThoughtWorks / Zhamak Dehghani (2019)</dom:frameworkOrigin>
    <dom:frameworkLifecycleStatus>Maturing</dom:frameworkLifecycleStatus>
    <dom:requiredCMMI_IT>Level 3-4</dom:requiredCMMI_IT>
    <dom:requiredCMMI_Org>Level 3-4</dom:requiredCMMI_Org>
    <dom:frameworkStrengths>Organizational scalability, domain empowerment, business agility, alignment with matrix structures.</dom:frameworkStrengths>
    <dom:frameworkWeaknesses>High implementation complexity, potential duplication, requires significant organizational maturity.</dom:frameworkWeaknesses>
    <dom:frameworkBestFor>Large enterprises with strong business silos and domain-driven design culture.</dom:frameworkBestFor>
    <dom:frameworkAvoidIf>SMEs, organizations with immature data practices, or those lacking self-serve platform capabilities.</dom:frameworkAvoidIf>
    <dom:indispensableCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</dom:indispensableCount>
    <dom:usefulCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</dom:usefulCount>
    <dom:optionalCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:optionalCount>
    <dom:totalDemand rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">59</dom:totalDemand>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#KPI_T_DomainQualityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPI" />
