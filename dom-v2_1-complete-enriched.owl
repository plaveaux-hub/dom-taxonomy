    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>PagerDuty, Slack alerting integrations, custom metric alert frameworks — threshold breach notification to metric owners</dom:itemText>
  </rdf:Description>
