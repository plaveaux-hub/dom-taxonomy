  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
       MANAGE.L2.1.L3.2 — Cost Accounting &amp; Chargeback
       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition"/>
    <dom:sectionText>Cost Accounting &amp; Chargeback is the capability to capture, allocate, and recover the full cost of data services and assets from the business units and products that consume them. It establishes a transparent economic relationship between data supply and demand, replacing opaque shared-service budgets with consumption-based cost visibility. The capability covers cost collection from infrastructure and labour, allocation modelling, chargeback or showback invoicing, and dispute resolution.</dom:sectionText>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext"/>
    <dom:sectionText>Without cost accounting and chargeback, the data function operates as an undifferentiated cost centre whose expenditure cannot be traced to business value. High-consumption teams free-ride on shared data infrastructure, low-value data products persist because their true cost is invisible, and CFOs cannot distinguish efficient from wasteful data spending. Budget negotiations become political rather than evidence-based, and the CDO loses credibility when unable to justify data spend in ROI terms.</dom:sectionText>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Cost pool definition — infrastructure, labour, licensing, and overhead costs grouped into allocable pools by service type</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Allocation modelling — usage-based drivers (query volume, storage consumed, pipeline runs) used to distribute costs to consuming units</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Showback vs. chargeback modes — showback for awareness-building phases; formal chargeback for mature organisations with internal market mechanisms</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Dispute and reconciliation process — structured workflow for business units to challenge allocations with supporting evidence</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Unit cost benchmarking — internal cost per service unit compared against cloud provider list prices and market benchmarks to assess efficiency</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_03_KeyAspects"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S03_I5"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Full cost transparency — 100% of data function costs traced to consuming business units, products, or shared overheads</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Demand-side accountability — business units optimise their data consumption when faced with actual cost signals</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>CDO budget credibility — data function costs justified by demonstrable consumption and value delivered, not historical baselines</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Continuous efficiency improvement — unit cost trends drive engineering decisions on platform optimisation and service rationalisation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_04_StrategicObjectives"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S04_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>GOVERN — Data Strategy sets the cost recovery model (cost centre, profit centre, or hybrid); Enterprise Architecture defines service boundaries used as allocation units</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>MANAGE — receives asset valuations as cost basis, feeds portfolio prioritisation with ROI signals, and publishes unit economics to Economic Performance Reporting</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>BUILD — platform and pipeline operating costs are metered at the service level and fed into cost pools for allocation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>RUN — analytics and data product consumption generates the usage metrics that drive allocation calculations for business unit chargebacks</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_05_RelationshipToMacroProcesses"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S05_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_06_DataEconomics"/>
    <dom:sectionText>Building a cost accounting and chargeback function requires initial tooling investment (FinOps platform integration, usage metering instrumentation) and 1–2 FTE of ongoing operation. The economic return is multi-dimensional: organisations that implement chargeback typically achieve 15–25% reduction in wasteful data consumption as business units self-police usage; engineering teams gain clear signals to retire low-use services; and the CDO can defend budget allocations with auditable consumption data rather than anecdotal evidence.</dom:sectionText>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>IN-SCOPE: All cloud and on-premise infrastructure costs attributable to data storage, processing, and transfer</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>IN-SCOPE: Labour costs of data engineering, data science, and data stewardship roles directly attributable to service delivery</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>IN-SCOPE: Software licensing costs for data platforms, tools, and third-party data subscriptions consumed by the organisation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>OUT-OF-SCOPE: Corporate overhead allocation (real estate, HR, legal) not directly attributable to data service delivery</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>OUT-OF-SCOPE: External pricing and invoicing to third-party data customers (handled by Data Monetization)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_07_ScopeBoundaries"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S07_I5"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Cloud FinOps and infrastructure billing systems — raw cost data from cloud providers (AWS Cost Explorer, Azure Cost Management, GCP Billing)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data platform usage telemetry (Snowflake credit consumption, Databricks DBU logs, pipeline run metadata) — the consumption drivers for allocation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>HR and Finance systems — staff cost rates, FTE allocation percentages, and procurement records for licensing costs</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Data Asset Valuation (MANAGE.L2.1.L3.1) — asset values used as the cost basis for amortisation components in service pricing</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_08_InputSuppliersProviders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S08_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Chief Data Officer (CDO) — approves cost allocation model, resolves escalated disputes, and presents data unit economics to CFO and executive committee</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>FinOps / Data Finance Manager — owns cost pool definitions, runs allocation models, produces chargeback invoices, and manages dispute resolution</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Business Unit Finance Controllers — receive chargeback statements and integrate data costs into their P&amp;L reporting</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Data Platform Engineers — instrument usage telemetry and ensure cost tags are correctly applied to all cloud resources</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Product and Analytics Managers — consume showback/chargeback reports and adjust their data usage decisions accordingly</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_09_Stakeholders"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S09_SH5"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Define and maintain the cost pool taxonomy aligned to data service catalogue (storage, processing, orchestration, governance, analytics delivery)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Instrument and validate usage metering across all data platforms, ensuring tagging completeness and accuracy before allocation runs</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Execute monthly allocation run: ingest cost data, apply allocation drivers, produce cost statements per business unit and product</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Distribute showback or chargeback statements to business unit finance controllers with supporting consumption detail</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Manage dispute process: receive challenges, investigate allocation logic, issue corrections or explanations within agreed SLA</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ActivityItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</dom:itemOrder>
    <dom:itemText>Publish quarterly unit cost benchmarks and trend analysis to engineering teams and CDO for efficiency management decisions</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_10_Activities"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A5"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S10_A6"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>FinOps platform (Apptio Cloudability, CloudHealth, FOCUS-compatible tools) — cost ingestion, tagging, allocation modelling, and showback dashboards</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Data platform native cost management (Snowflake Resource Monitors, Databricks Cost Attribution, BigQuery slot usage) — granular consumption metering</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>ERP / Finance system (SAP, Oracle Financials) — integration point for chargeback posting and P&amp;L reconciliation</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ToolItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>BI reporting layer (Power BI, Tableau, Looker) — self-service cost dashboards for business unit managers and engineering teams</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_11_Tools"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S11_T4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Monthly chargeback or showback statements — itemised cost allocations per business unit with consumption breakdown and trend versus prior periods</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Cost allocation model documentation — methodology, driver definitions, allocation keys, and change log for each allocation cycle</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Unit cost benchmark report — cost per TB stored, cost per pipeline run, cost per active user, trended quarterly with market comparables</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Dispute log and resolution record — all challenges received, investigation outcomes, and corrections applied</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_12_PrimaryDeliverables"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S12_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Economic Performance Reporting (MANAGE.L2.1.L3.5) — chargeback data feeds the data P&amp;L and value-for-money dashboards presented to leadership</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Portfolio Management &amp; Demand Prioritization (MANAGE.L2.1.L3.3) — cost signals shape demand-side decisions on which projects receive data engineering resources</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Business Unit Finance Controllers — incorporate chargeback into product P&amp;L, driving internal pricing and margin improvement decisions</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Data Platform Engineering — unit cost benchmarks trigger infrastructure right-sizing, caching strategies, and decommissioning initiatives</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_13_OutcomesConsumers"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S13_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Cost allocation coverage — percentage of total data function spend allocated to identifiable consuming units (vs. unallocated overhead)</dom:itemText>
    <dom:kpiTarget>&gt;90%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Tagging completeness — percentage of cloud resources with mandatory cost allocation tags correctly applied</dom:itemText>
    <dom:kpiTarget>&gt;98%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Dispute rate — percentage of chargeback statements challenged by receiving business units</dom:itemText>
    <dom:kpiTarget>&lt;5%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Unit cost trend — year-on-year change in cost per standard service unit (storage TB, query TB, pipeline run)</dom:itemText>
    <dom:kpiTarget>Year-on-year reduction &gt;5%</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Statement delivery timeliness — percentage of monthly chargeback statements delivered by agreed deadline</dom:itemText>
    <dom:kpiTarget>100% by day 10 of following month</dom:kpiTarget>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_14_KPIs"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K4"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S14_K5"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Near-complete resource tagging before launch — a chargeback model built on incomplete tagging produces disputed results that destroy stakeholder trust</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Showback period before chargeback — 3–6 months of cost visibility without financial consequence builds understanding and buy-in</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>CFO mandate for chargeback integration into P&amp;L — without Finance system integration, chargeback becomes a shadow report ignored at budget time</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Simple and explainable allocation model — overly complex models generate disputes; the goal is transparency, not accounting precision</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_15_SuccessFactors"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I3"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2_S15_I4"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_MANAGE_L2.1_L3.2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySpecification"/>
    <rdfs:label xml:lang="en">Specification: Cost Accounting &amp; Chargeback</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.2_CostAccountingChargeback"/>
