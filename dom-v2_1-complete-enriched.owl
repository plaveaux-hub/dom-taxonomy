    <dom:primaryFocus>True capability costs</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_DataEconomicsPerformance" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#kpiFrequency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">KPI frequency</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#KPIItem" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="en">Measurement frequency (e.g. 'Monthly', 'Quarterly').</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#L2Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DOMElement" />
    <rdfs:label xml:lang="en">L2 Capability</rdfs:label>
    <rdfs:label xml:lang="fr">Capability L2</rdfs:label>
    <rdfs:comment xml:lang="en">Second-level capability within a Macro-Process. Each L2 represents a major functional area of data management. The DOM defines 12 L2 capabilities.</rdfs:comment>
    <dom:bookChapter>Chapter 3 - The DOM Framework: Capability Overview</dom:bookChapter>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#DimensionalAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Dimensional Assessment</rdfs:label>
    <rdfs:label xml:lang="fr">Evaluation Dimensionnelle</rdfs:label>
    <rdfs:comment xml:lang="en">A maturity assessment of a specific capability on a specific dimension.
This is the atomic unit of the Maturity Assessment Workbook (Tool 1).
Each assessment captures a score (1-5), optionally scoped to an
organizational unit (Phase 3) and timestamped for temporal tracking.

Example: 'Data Quality Management scored 4/5 on People dimension
in the Finance domain as of Q1 2026.'</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#ITUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OrganizationalUnit" />
    <rdfs:label xml:lang="en">IT Unit</rdfs:label>
    <rdfs:label xml:lang="fr">Unite IT</rdfs:label>
    <rdfs:comment xml:lang="en">An IT organizational unit — centralized IT, domain IT, platform team, etc.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#containsAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">contains assignment</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OrganizationalSnapshot" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilityAssignment" />
    <rdfs:comment xml:lang="en">Links a snapshot to all capability assignments captured at that point in time.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Stakeholder</rdfs:label>
    <rdfs:label xml:lang="en">Stakeholder Type</rdfs:label>
    <rdfs:label xml:lang="fr">Type de Partie Prenante</rdfs:label>
    <rdfs:comment xml:lang="en">A stakeholder role as defined in Annex V (25 types). Phase 4 will fully specify.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stakeholder type as defined in DOM Annex V (25 types across 4 categories).
These are ROLE TYPES, not individuals. Individuals in an organization
are mapped to stakeholder types via dom:PersonAssignment.</rdfs:comment>
    <dom:phaseHook>Phase 4 - Stakeholders &amp; RACI</dom:phaseHook>
    <dom:bookChapter>Annex V - DOM Stakeholder Reference Guide</dom:bookChapter>
  </rdf:Description>
