    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.2_L3.2_DataComplianceLegalPrivacy" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.2_L3.3_OwnershipStewardship" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.2_L3.4_DataAuditCertification" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.2_L3.5_MLAIModelGovernance" />
  </rdf:Description>
