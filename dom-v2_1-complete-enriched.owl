    <rdfs:label xml:lang="en">Data Fabric</rdfs:label>
    <dom:frameworkOrigin>Gartner / IBM / Informatica (2016-2018)</dom:frameworkOrigin>
    <dom:frameworkLifecycleStatus>Disillusionment</dom:frameworkLifecycleStatus>
    <dom:requiredCMMI_IT>Level 3-4</dom:requiredCMMI_IT>
    <dom:requiredCMMI_Org>Level 3-4</dom:requiredCMMI_Org>
    <dom:frameworkStrengths>Automated integration, metadata-driven intelligence, cross-platform governance.</dom:frameworkStrengths>
    <dom:frameworkWeaknesses>Very complex (52/63 capabilities indispensable), heavy vendor dependency, few complete implementations.</dom:frameworkWeaknesses>
    <dom:frameworkBestFor>Large enterprises needing automated, metadata-driven data integration across heterogeneous landscapes.</dom:frameworkBestFor>
    <dom:frameworkAvoidIf>SMEs, organizations without Level 3+ maturity.</dom:frameworkAvoidIf>
    <dom:indispensableCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52</dom:indispensableCount>
    <dom:usefulCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</dom:usefulCount>
    <dom:optionalCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:optionalCount>
    <dom:totalDemand rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62</dom:totalDemand>
  </rdf:Description>
