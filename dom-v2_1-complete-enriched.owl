    <dom:bscIndicatorType>3 Leading</dom:bscIndicatorType>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SectionItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Section Item</rdfs:label>
    <rdfs:comment xml:lang="en">A single structured item within a section (an activity, a tool, a KPI, a stakeholder reference, a deliverable, etc.).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#GAP_CoverageAsymmetry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
