    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>AI incident response time — Time from detection to initial response</dom:itemText>
    <dom:kpiTarget>&lt;24 hours</dom:kpiTarget>
  </rdf:Description>
