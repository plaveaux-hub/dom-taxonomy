    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Model monitoring treated as operational requirement, not optional enhancement</dom:itemText>
  </rdf:Description>
