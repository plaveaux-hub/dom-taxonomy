  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#KPIMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">KPI Measurement</rdfs:label>
    <rdfs:label xml:lang="fr">Mesure de KPI</rdfs:label>
    <rdfs:comment xml:lang="en">An actual measured value of a KPI at a point in time, optionally
scoped to an organizational unit. This is the operational data that
powers the Executive Scorecard and cascade analysis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#FrameworkRating">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Framework Rating</rdfs:label>
    <rdfs:label xml:lang="fr">Evaluation Framework</rdfs:label>
    <rdfs:comment xml:lang="en">A single cell in the 756-cell mapping matrix (63 L3 × 12 frameworks).
Records the intensity level at which a framework demands a specific L3
capability. This is the data that proves every framework is incomplete
and that the DOM provides the stable substrate underneath.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.6_RegulatoryAffairsAuthorityManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Regulatory Affairs &amp; Authority Management</rdfs:label>
    <skos:definition xml:lang="en">Interface management with regulatory authorities and compliance bodies.</skos:definition>
    <dom:capabilityId>MANAGE.L2.2.L3.6</dom:capabilityId>
    <dom:primaryFocus>Regulator interface</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_DataSecurity" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_L3.1_TransactionalDataPlatforms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Transactional Data Platforms</rdfs:label>
    <skos:definition xml:lang="en">OLTP systems and transactional data platform management.</skos:definition>
    <dom:capabilityId>BUILD.L2.2.L3.1</dom:capabilityId>
    <dom:primaryFocus>OLTP systems</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_DataProvisioning" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.3_L3.4_DataLineageImpactAnalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Lineage &amp; Impact Analysis</rdfs:label>
    <skos:definition xml:lang="en">End-to-end traceability of data flows, critical for AI Act compliance.</skos:definition>
    <dom:capabilityId>MANAGE.L2.3.L3.4</dom:capabilityId>
    <dom:primaryFocus>End-to-end traceability</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.3_DataCataloguing" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#VC_DataStrategy_to_MANAGE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ValueChainLink" />
    <rdfs:label xml:lang="en">Data Strategy → MANAGE (strategic priorities)</rdfs:label>
    <dom:supplierCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.1_L3.1_DataStrategyCommunication" />
    <dom:consumerCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE" />
    <dom:valueChainOutput>Strategic priorities for operational planning</dom:valueChainOutput>
    <dom:chainStrength>critical</dom:chainStrength>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#frameworkAvoidIf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">avoid if</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Framework" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#OM_Centralized">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OperatingModel" />
    <rdfs:label xml:lang="en">Centralized</rdfs:label>
    <rdfs:label xml:lang="fr">Centralise</rdfs:label>
    <skos:definition xml:lang="en">Central team (CDO office, shared service) delivers for this domain. Domain consumes but does not operate.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_ChiefDataArchitect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">Chief Data Architect</rdfs:label>
    <skos:altLabel>Enterprise Data Architect</skos:altLabel>
    <skos:altLabel>VP Data Architecture</skos:altLabel>
    <skos:altLabel>Head of Data Architecture</skos:altLabel>
    <skos:definition xml:lang="en">Technical leader of enterprise data architecture. Defines architectural principles, integration patterns, and technical standards.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CLevelExecutive" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MacroProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DOMElement" />
    <rdfs:label xml:lang="en">Macro-Process (L0)</rdfs:label>
    <rdfs:label xml:lang="fr">Macro-Processus (L0)</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level organizational category in the DOM. The four macro-processes represent the complete data management lifecycle: GOVERN, MANAGE, BUILD, RUN.</rdfs:comment>
    <dom:bookChapter>Chapter 2 - The DOM Architecture</dom:bookChapter>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#frameworkBestFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">best for</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Framework" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
