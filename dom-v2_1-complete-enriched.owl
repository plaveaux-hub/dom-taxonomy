    <skos:definition xml:lang="en">Knowledge discovery through enterprise search and information retrieval.</skos:definition>
    <dom:capabilityId>RUN.L2.2.L3.4</dom:capabilityId>
    <dom:primaryFocus>Knowledge discovery</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#KPIItem">
