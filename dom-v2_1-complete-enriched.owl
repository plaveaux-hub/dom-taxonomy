    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S05_I1"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S05_I2"/>
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.3_S05_I3"/>
