  <!-- ═══════════════════════════════════════════════════
       Specification: Data Incident Management (RUN.L2.3.L3.3)
       ═══════════════════════════════════════════════════ -->
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S01">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition" />
    <dom:sectionText xml:lang="en">Data Incident Management is the capability to provide a structured, repeatable response process for data-layer incidents in production: pipeline failures, data quality breaches, data loss events, latency violations, and regulatory data exposure incidents. It adapts ITIL incident management principles to the specific characteristics of data systems — including assessment of consumer impact scope, data loss quantification, lineage-based blast radius analysis, and coordination with data stewardship and regulatory teams where required. The capability closes the loop between detection (observability), response, remediation, root-cause analysis, and systemic prevention.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S02">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext" />
    <dom:sectionText xml:lang="en">Without a structured data incident process, organisations default to ad hoc heroics where the most vocal engineer handles each crisis differently, post-mortems are skipped under time pressure, and the same failures recur indefinitely. Data incidents have compounding effects: a missed pipeline failure that goes unresolved cascades to multiple consumer systems, corrupts downstream models, and produces executive-level trust failures. The regulatory dimension of data incidents — particularly where personal or financial data is involved — demands documented, defensible response timelines that informal processes cannot provide.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Incident triage &amp; severity classification — structured assessment of incident severity (P1–P4) based on consumer impact, data loss scope, SLA breach status, and regulatory exposure risk</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Escalation &amp; coordination — clear escalation paths from on-call engineer through data product owner, CDO, and regulatory response teams based on incident severity level</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Root-cause analysis (RCA) — systematic investigation of incident origin using pipeline logs, lineage traces, and observability data to identify the technical and process failure points</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Remediation &amp; data recovery — execution of data backfill, re-processing, or correction procedures to restore data completeness and accuracy following an incident</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">Post-mortem &amp; prevention — blameless post-mortem process producing documented learnings, corrective actions, and preventive controls entered into the improvement backlog</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_03_KeyAspects" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I4" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S03_I5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Minimise consumer impact duration — reduce the time between incident detection and data service restoration through structured, pre-planned response procedures</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Prevent recurrence — convert each incident into documented learning and preventive controls that reduce future incident probability and severity</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Regulatory defensibility — maintain documented evidence of incident detection, response timeline, escalation, and remediation for compliance and audit purposes</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Operational maturity progression — use incident trend analysis to identify systemic weaknesses in pipelines, tooling, and processes driving a continuous reliability improvement cycle</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_04_StrategicObjectives" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S04_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">GOVERN — Data Privacy &amp; Security Governance (GOVERN.L2.3) defines when data incidents require regulatory escalation (GDPR breach notification); Data Policy sets acceptable incident response SLAs</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">MANAGE — Data Breach Detection &amp; Incident Response (MANAGE.L2.2.L3.3) handles the security and regulatory dimension of data incidents; Business Continuity (MANAGE.L2.5.L3.2) provides DR procedures invoked for major incidents</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">BUILD — pipeline and infrastructure failures investigated during RCA may result in BUILD team corrective work; BUILD.L2.1 delivers hotfixes and emergency patches</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">RUN — receives incident triggers from Data Platform Observability (L2.3.L3.2) and Pipeline Operations (L2.3.L3.1); closed incidents feed the continuous improvement backlog in MANAGE.L2.5.L3.4</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_05_RelationshipToMacroProcesses" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S05_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S06">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_06_DataEconomics" />
    <dom:sectionText xml:lang="en">Data incident management tooling (PagerDuty, ServiceNow, Jira Service Management) carries predictable subscription costs, while the cost of unmanaged data incidents is highly variable and potentially catastrophic — from regulatory fines for undetected personal data loss to reputational damage from incorrect public reporting. Organisations with mature incident management frameworks report significantly shorter MTTR, with blameless post-mortem cultures demonstrating measurable reductions in repeat incident categories quarter-on-quarter.</dom:sectionText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: Structured triage, response, and resolution process for all production data incidents including pipeline failures, quality breaches, and latency violations</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: Root-cause analysis, post-mortem documentation, and preventive action tracking for all P1 and P2 severity incidents</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">IN-SCOPE: Coordination with regulatory and security teams for data incidents involving personal, financial, or regulated data exposure</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">OUT-OF-SCOPE: Security incident response for infrastructure-level intrusions or access control breaches — these are managed by IT Security / MANAGE.L2.2</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">OUT-OF-SCOPE: Ongoing data quality stewardship and business rule enforcement — these are managed within MANAGE.L2.4 (Data Quality Management)</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3_S07">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.3" />
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_07_ScopeBoundaries" />
