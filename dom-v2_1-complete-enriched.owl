    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_DataProvisioning" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.1_DataOrchestrationChoreography" />
