    <rdfs:label xml:lang="en">Specification: Data Asset Management</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_DataAssetManagement"/>
