  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#EX_Gap_GDPR_SubsidXYZ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GapFinding" />
    <rdfs:label xml:lang="en">GDPR Consent absent in acquired subsidiary</rdfs:label>
    <dom:gapType rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GAP_StructuralBlank" />
    <dom:gapCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.4_GDPRConsentPreferenceManagement" />
    <dom:gapUnit rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#EX_SubsidXYZ" />
    <dom:gapSeverity>critical</dom:gapSeverity>
    <dom:gapDescription>XYZ Assurances acquired 18 months ago has no GDPR consent management. Regulatory exposure for the group.</dom:gapDescription>
    <dom:gapDetectedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dom:gapDetectedDate>
    <dom:gapDetectedInSnapshot rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#EX_Snapshot_Q1_2026" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MaturityLevel_3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MaturityLevel" />
    <rdfs:label xml:lang="en">Level 3: Defined</rdfs:label>
    <skos:definition xml:lang="en">Standardized processes. Organization-wide adoption. Measured.</skos:definition>
    <dom:maturityScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:maturityScore>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#Section_05_RelationshipMacroProcesses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilitySection" />
    <rdfs:label xml:lang="en">Section 5: Relationship to Other Macro-Processes</rdfs:label>
    <rdfs:label xml:lang="fr">Section 5 : Relations aux Macro-Processus</rdfs:label>
    <skos:definition xml:lang="en">How this capability interacts with GOVERN, MANAGE, BUILD, and RUN. Source of cross-capability relationships (drives, constrains, feedsInto, monitors).</skos:definition>
    <dom:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:sectionNumber>
    <dom:sectionCategory>Strategy</dom:sectionCategory>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_L3.4_DataVirtualizationFederation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Virtualization &amp; Federation</rdfs:label>
    <skos:definition xml:lang="en">Logical access layer providing virtual views without physical data movement.</skos:definition>
    <dom:capabilityId>BUILD.L2.2.L3.4</dom:capabilityId>
    <dom:primaryFocus>Logical access layer</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.2_DataProvisioning" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.2_DataClassificationProtectionEncryption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Classification, Protection &amp; Encryption</rdfs:label>
    <skos:definition xml:lang="en">Data-centric protection through classification schemes and encryption.</skos:definition>
    <dom:capabilityId>MANAGE.L2.2.L3.2</dom:capabilityId>
    <dom:primaryFocus>Data-centric protection</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_DataSecurity" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#OM_Contested">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OperatingModel" />
    <rdfs:label xml:lang="en">Contested</rdfs:label>
    <rdfs:label xml:lang="fr">Conteste</rdfs:label>
    <skos:definition xml:lang="en">Multiple teams claim ownership with divergent approaches. Frequent in post-M&amp;A or large matrix organizations. Requires resolution.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_L3.4_GDPRConsentPreferenceManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">GDPR Consent &amp; Preference Management</rdfs:label>
    <skos:definition xml:lang="en">Granular, traceable management of consent as a data asset — atomic capability concept.</skos:definition>
    <dom:capabilityId>MANAGE.L2.2.L3.4</dom:capabilityId>
    <dom:primaryFocus>Consent lifecycle</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.2_DataSecurity" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#takenDuringSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">taken during snapshot</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilityAssignment" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OrganizationalSnapshot" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#OM_Emerging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OperatingModel" />
    <rdfs:label xml:lang="en">Emerging</rdfs:label>
    <rdfs:label xml:lang="fr">Emergent</rdfs:label>
    <skos:definition xml:lang="en">Capability developing organically within the domain. Not yet formalized but showing signs of deliberate practice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_L3.1_SLADefinitionMonitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Service Level Agreement Definition &amp; Monitoring</rdfs:label>
    <skos:definition xml:lang="en">SLA architecture for data services.</skos:definition>
    <dom:capabilityId>MANAGE.L2.5.L3.1</dom:capabilityId>
    <dom:primaryFocus>SLA architecture</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.5_DataServiceLevelManagement" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#targetOperatingModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">target operating model</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilityAssignment" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OperatingModel" />
    <rdfs:comment xml:lang="en">The DESIRED operating model from strategic planning.
This is the top-down target. The gap between observed and target
is the material for the convergence roadmap.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_L3.5_EconomicPerformanceReporting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Economic Performance Reporting</rdfs:label>
    <skos:definition xml:lang="en">CFO-grade ROI measurement and reporting for data investments.</skos:definition>
    <dom:capabilityId>MANAGE.L2.1.L3.5</dom:capabilityId>
    <dom:primaryFocus>ROI measurement</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.1_DataEconomicsPerformance" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#integrationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">integration status</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Subsidiary" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="en">Status of data capability integration: 'not_started', 'in_progress', 'completed', 'deferred'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#hasDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">has dimension</rdfs:label>
    <rdfs:comment xml:lang="en">Links any DOM element to a Dimension for analysis. Every capability implicitly has all 4 dimensions; this property is used in DimensionalAssessment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#GAP_BrokenValueChain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GapType" />
    <rdfs:label xml:lang="en">Broken Value Chain</rdfs:label>
    <skos:definition xml:lang="en">A value chain link where the supplier capability is in a different
org unit (or operating model) than the consumer, and no integration
mechanism exists. Detected by crossing ValueChainLinks with
CapabilityAssignments from Phase 3.

Example: Data Quality (centralized in CDO office) feeds Data Product
Delivery (federated in BUs) — but BU teams don't consume quality
outputs because they lack access to central quality dashboards.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_ExternalSuppliers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">External Suppliers</rdfs:label>
    <skos:altLabel>Data Vendors</skos:altLabel>
    <skos:altLabel>Technology Vendors</skos:altLabel>
    <skos:altLabel>Consulting Partners</skos:altLabel>
    <skos:definition xml:lang="en">External data and technology suppliers providing inputs to data capabilities.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ExternalParty" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_SupportTeams">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">Support Teams</rdfs:label>
    <skos:altLabel>Helpdesk</skos:altLabel>
    <skos:altLabel>Service Desk</skos:altLabel>
    <skos:definition xml:lang="en">Support teams handling data-related incidents and service requests.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#TechnicalTeam" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#itemOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">item order</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <rdfs:comment xml:lang="en">Display order of this item within its section.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#strategyBestFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">strategy best for</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#HybridStrategy" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RETAIL_ClickShop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Subsidiary" />
    <rdfs:label xml:lang="en">ClickShop (e-commerce, merged)</rdfs:label>
    <dom:isSubUnitOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RETAIL_NovaMart" />
    <dom:acquisitionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-01</dom:acquisitionDate>
    <dom:integrationStatus>in_progress</dom:integrationStatus>
    <dom:location>Berlin</dom:location>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#ValueChainLink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Value Chain Link</rdfs:label>
    <rdfs:label xml:lang="fr">Lien de Chaine de Valeur</rdfs:label>
    <rdfs:comment xml:lang="en">A directional link in the DOM value chain: one capability supplies
an output that another capability consumes as input.

Extracted from Section 8 (Input Suppliers) and Section 13 (Outcomes
Consumers). When a capability's Section 8 references another capability,
and that capability's Section 13 references back, the chain is confirmed.

When combined with Phase 3 CapabilityAssignment, enables detection of
broken chains: supplier and consumer in different org units without
integration, or supplier capability absent in the domain where the
consumer needs it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_ServiceDeliveryManager">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">Service Delivery Manager</rdfs:label>
    <skos:definition xml:lang="en">Manages data service delivery and SLA compliance. Key for MANAGE L2.5.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BusinessRole" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#FR_Mesh_MDM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#FrameworkRating" />
    <rdfs:label xml:lang="en">Data Mesh × Master Data</rdfs:label>
    <dom:ratingFramework rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#FW_DataMesh" />
    <dom:ratingCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_L3.1_MasterReferenceDataManagement" />
    <dom:ratingIntensity rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#FI_Useful" />
    <dom:ratingNotes>Cross-domain consistency needs MDM but Mesh doesn't mandate golden records.</dom:ratingNotes>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#carriedByTeam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">carried by team</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#CapabilityAssignment" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DataTeam" />
    <rdfs:comment xml:lang="en">The specific data team executing this capability (may differ from the org unit that 'owns' it).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#raciCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">RACI capability</rdfs:label>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RACIAssignment" />
    <rdfs:range rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:comment xml:lang="en">The L3 capability this RACI assignment applies to.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BSC_LearningGrowth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
