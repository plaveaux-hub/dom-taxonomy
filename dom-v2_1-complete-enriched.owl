  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SectionContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Section Content</rdfs:label>
    <rdfs:label xml:lang="fr">Contenu de Section</rdfs:label>
    <rdfs:comment xml:lang="en">The actual content of one section within a CapabilitySpecification.
Contains both free text (for documentation) and structured items
(for SPARQL queries and tooling). A SectionContent links to exactly
one CapabilitySection (the template) and one CapabilitySpecification
(the L3 being described).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RACIRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">RACI Role</rdfs:label>
    <rdfs:comment xml:lang="en">One of the four RACI responsibility types.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#VC_GOVERN_to_DQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#ValueChainLink" />
    <rdfs:label xml:lang="en">GOVERN → Data Quality (standards &amp; policies)</rdfs:label>
    <dom:supplierCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN" />
    <dom:consumerCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#MANAGE_L2.4_L3.2_DataQualityManagement" />
    <dom:valueChainOutput>Quality standards and policies</dom:valueChainOutput>
    <dom:chainStrength>critical</dom:chainStrength>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#maturityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">maturity score</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <rdfs:comment xml:lang="en">Maturity score (1-5) for a capability in a given dimension/org unit. Phase 3.</rdfs:comment>
    <rdfs:comment xml:lang="en">Score from 1 (Initial) to 5 (Optimized).</rdfs:comment>
    <dom:phaseHook>Phase 3 - Organizational Instantiation</dom:phaseHook>
    <rdfs:domain rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#DimensionalAssessment" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_BusinessUnits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">Business Units</rdfs:label>
    <skos:definition xml:lang="en">Business units as collective stakeholders in data capability delivery.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BusinessRole" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.1_L3.1_DataStrategyCommunication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Strategy &amp; Communication</rdfs:label>
    <skos:definition xml:lang="en">Strategic alignment and stakeholder buy-in for data initiatives.</skos:definition>
    <dom:capabilityId>GOVERN.L2.1.L3.1</dom:capabilityId>
    <dom:primaryFocus>Strategic alignment, stakeholder buy-in</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#GOVERN_L2.1_DataStrategyDirection" />
    <dom:hasSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#ExternalParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderCategory" />
    <rdfs:label xml:lang="en">External Party</rdfs:label>
    <rdfs:label xml:lang="fr">Partie Externe</rdfs:label>
    <skos:definition xml:lang="en">External stakeholders and suppliers (2 types).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_DataIntegrationTeam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Stakeholder" />
    <rdfs:label xml:lang="en">Data Integration Team</rdfs:label>
    <skos:altLabel>Data Engineering Team</skos:altLabel>
    <skos:altLabel>ETL Team</skos:altLabel>
    <skos:definition xml:lang="en">Team responsible for data transport, integration and pipeline operations.</skos:definition>
    <dom:belongsToCategory rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#TechnicalTeam" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#TechnicalTeam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderCategory" />
    <rdfs:label xml:lang="en">Technical Team</rdfs:label>
    <rdfs:label xml:lang="fr">Equipe Technique</rdfs:label>
    <skos:definition xml:lang="en">Technical teams implementing and operating data capabilities (4 types).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.5_DataAPIServicesManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data API &amp; Services Management</rdfs:label>
    <skos:definition xml:lang="en">Programmatic data access through APIs — critical for Data Mesh implementations.</skos:definition>
    <dom:capabilityId>RUN.L2.1.L3.5</dom:capabilityId>
    <dom:primaryFocus>Programmatic access</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_ChiefFinancialOfficer">
