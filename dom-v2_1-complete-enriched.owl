    <dom:itemText>Data Owner responsibilities embedded in role profiles and performance objectives</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.2_L3.3_S04_I3">
