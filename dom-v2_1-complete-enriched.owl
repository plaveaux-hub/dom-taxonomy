  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#FW_DataLakehouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Framework" />
    <rdfs:label xml:lang="en">Data Lakehouse</rdfs:label>
    <dom:frameworkOrigin>Databricks / Delta Lake (2020)</dom:frameworkOrigin>
    <dom:frameworkLifecycleStatus>Growing</dom:frameworkLifecycleStatus>
    <dom:requiredCMMI_IT>Level 2-3</dom:requiredCMMI_IT>
    <dom:requiredCMMI_Org>Level 2-3</dom:requiredCMMI_Org>
    <dom:frameworkStrengths>Lake/warehouse unification, cost reduction, ML+BI support, open formats, growing vendor ecosystem.</dom:frameworkStrengths>
    <dom:frameworkWeaknesses>Relatively recent, requires specific expertise, complex migration, vendor concentration risk.</dom:frameworkWeaknesses>
    <dom:frameworkBestFor>New analytical platforms, organizations needing combined ML + BI capabilities, cloud-native environments.</dom:frameworkBestFor>
    <dom:frameworkAvoidIf>Organizations with well-functioning existing warehouses where migration costs outweigh benefits.</dom:frameworkAvoidIf>
    <dom:indispensableCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</dom:indispensableCount>
    <dom:usefulCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</dom:usefulCount>
    <dom:optionalCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</dom:optionalCount>
    <dom:totalDemand rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55</dom:totalDemand>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#EX_Gap_DQ_Asymmetry">
