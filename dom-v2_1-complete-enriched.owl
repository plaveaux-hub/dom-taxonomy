    <rdfs:label xml:lang="en">Specification: Decision Intelligence &amp; Optimization</rdfs:label>
    <dom:specifiesCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_L3.6_DecisionIntelligenceOptimization"/>
