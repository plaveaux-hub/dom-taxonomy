  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#Subsidiary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#OrganizationalUnit" />
    <rdfs:label xml:lang="en">Subsidiary</rdfs:label>
    <rdfs:label xml:lang="fr">Filiale</rdfs:label>
    <rdfs:comment xml:lang="en">An acquired or created subsidiary entity. Critical for post-M&amp;A analysis where capability coverage gaps are common.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#Framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data Framework</rdfs:label>
    <rdfs:label xml:lang="fr">Framework Data</rdfs:label>
    <rdfs:comment xml:lang="en">An external data management framework (Data Mesh, Lakehouse, etc.). Phase 5 will fully specify.</rdfs:comment>
    <rdfs:comment xml:lang="en">A major data management framework mapped against DOM capabilities.
The DOM integrates WITH — rather than competes against — every major
framework. Each framework is assessed for capability demand intensity
(Indispensable/Useful/Optional per L3), lifecycle status, required
maturity, strengths, and weaknesses. (DOM Chapter 4)</rdfs:comment>
    <dom:phaseHook>Phase 5 - Framework Integration &amp; KPIs</dom:phaseHook>
    <dom:bookChapter>Chapter 4 - Framework Integration Guide</dom:bookChapter>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#monitors">
