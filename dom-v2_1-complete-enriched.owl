    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_08_InputSuppliersProviders" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I1" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I2" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I3" />
    <dom:hasItem rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S08_I4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09_I1">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText xml:lang="en">Head of Data Engineering / DataOps Lead — accountable for pipeline reliability, on-call rota, and DataOps toolchain investment</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09_I2">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Pipeline Engineers (on-call) — execute monitoring, respond to alerts, perform recovery procedures, and deploy pipeline changes</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09_I3">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText xml:lang="en">Platform SRE / DevOps Engineer — manages orchestration infrastructure, CI/CD pipelines, and deployment tooling</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09_I4">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Product Owner — defines SLA requirements for their domain pipelines; receives breach notifications and approves remediation priorities</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09_I5">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#StakeholderItem" />
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText xml:lang="en">Data Consumers (BI, Analytics, DS teams) — primary stakeholders for SLA compliance; report data freshness or completeness issues</dom:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1_S09">
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#owl:NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent" />
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_RUN_L2.3_L3.1" />
