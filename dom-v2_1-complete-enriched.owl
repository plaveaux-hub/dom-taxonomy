    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.3_BatchDataTransferProcessing" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.4_ChangeDataCaptureEventSourcing" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.5_ExternalDataSupplierManagement" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.1_L3.6_ScreenWebScraping" />
  </rdf:Description>
