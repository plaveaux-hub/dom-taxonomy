    <rdfs:label xml:lang="en">Leading</rdfs:label>
    <skos:definition xml:lang="en">Predictive indicator — measures inputs, activities, or conditions that drive future outcomes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SH_BusinessUnitLeaders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
