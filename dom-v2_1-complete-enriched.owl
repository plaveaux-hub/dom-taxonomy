  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.1_BusinessIntelligenceReportingDelivery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Business Intelligence &amp; Reporting Delivery</rdfs:label>
    <skos:definition xml:lang="en">Structured reports, visualizations, and dashboards delivering business intelligence to decision-makers across the organization.</skos:definition>
    <dom:capabilityId>RUN.L2.1.L3.1</dom:capabilityId>
    <dom:primaryFocus>BI delivery, reporting, dashboards</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.2_SelfServiceAnalytics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Self-Service Analytics</rdfs:label>
    <skos:definition xml:lang="en">Empowers business users to explore, query, and analyse data autonomously through governed self-service platforms and semantic layers.</skos:definition>
    <dom:capabilityId>RUN.L2.1.L3.2</dom:capabilityId>
    <dom:primaryFocus>User-driven exploration, governed access</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_L3.3_DataProductCatalogueDiscoverability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Data Product Catalogue &amp; Discoverability</rdfs:label>
    <skos:definition xml:lang="en">Makes data products findable, understandable, and trustworthy through cataloguing, ownership declaration, SLA exposure, and consumer-facing discovery interfaces.</skos:definition>
    <dom:capabilityId>RUN.L2.1.L3.3</dom:capabilityId>
    <dom:primaryFocus>Discoverability, trust, consumer experience</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.1_DataProductDelivery" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_L3.3_GenerativeAILLMApplications">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Generative AI &amp; LLM Applications</rdfs:label>
    <skos:definition xml:lang="en">Design and operation of generative AI applications leveraging large language models, including prompt engineering, retrieval-augmented generation, and enterprise LLM deployment.</skos:definition>
    <dom:capabilityId>RUN.L2.2.L3.3</dom:capabilityId>
    <dom:primaryFocus>LLM deployment, RAG, generative applications</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_L3.5_MLModelDevelopmentExperimentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">ML Model Development &amp; Experimentation</rdfs:label>
    <skos:definition xml:lang="en">End-to-end machine learning model development lifecycle: problem framing, feature engineering, training, evaluation, and experiment tracking prior to production deployment.</skos:definition>
    <dom:capabilityId>RUN.L2.2.L3.5</dom:capabilityId>
    <dom:primaryFocus>Model development, experiment tracking</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_L3.6_DecisionIntelligenceOptimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Decision Intelligence &amp; Optimization</rdfs:label>
    <skos:definition xml:lang="en">Automated and augmented decision-making through optimization models, simulation, prescriptive analytics, and decision support systems embedded in business processes.</skos:definition>
    <dom:capabilityId>RUN.L2.2.L3.6</dom:capabilityId>
    <dom:primaryFocus>Prescriptive analytics, automated decisions</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_AIDataEngineering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L2Capability" />
    <rdfs:label xml:lang="en">AI &amp; Data Engineering</rdfs:label>
    <rdfs:label xml:lang="fr">Ingenierie IA &amp; Data</rdfs:label>
    <skos:definition xml:lang="en">Constructs the engineering infrastructure enabling AI and machine learning capabilities: feature management, ML pipelines, model registries, and inference serving. Bridges data platform capabilities and AI-powered applications in RUN.</skos:definition>
    <dom:capabilityId>BUILD.L2.3</dom:capabilityId>
    <dom:l3Count rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:l3Count>
    <dom:bookChapter>Chapter 3.3 / Annex III</dom:bookChapter>
    <dom:belongsToMacroProcess rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD" />
    <dom:feedsInto rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#RUN_L2.2_DataInsights" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.1_FeatureStoreTrainingDataManagement" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.2_MLPipelineModelInfrastructure" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.3_LLMServingInferenceInfrastructure" />
    <dom:hasL3SubCapability rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.4_ModelRegistryVersioning" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.1_FeatureStoreTrainingDataManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Feature Store &amp; Training Data Management</rdfs:label>
    <skos:definition xml:lang="en">Centralised management of ML features ensuring consistency between training and serving, and governance of training datasets including versioning and lineage.</skos:definition>
    <dom:capabilityId>BUILD.L2.3.L3.1</dom:capabilityId>
    <dom:primaryFocus>Feature consistency, training data governance</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_AIDataEngineering" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.2_MLPipelineModelInfrastructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">ML Pipeline &amp; Model Infrastructure</rdfs:label>
    <skos:definition xml:lang="en">Engineering and orchestration of end-to-end ML pipelines covering data preparation, training runs, evaluation, and automated retraining in production environments.</skos:definition>
    <dom:capabilityId>BUILD.L2.3.L3.2</dom:capabilityId>
    <dom:primaryFocus>Pipeline orchestration, automated retraining</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_AIDataEngineering" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.3_LLMServingInferenceInfrastructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">LLM Serving &amp; Inference Infrastructure</rdfs:label>
    <skos:definition xml:lang="en">Infrastructure for deploying and serving large language models and AI inference workloads at scale, covering latency management, cost control, and model hosting patterns.</skos:definition>
    <dom:capabilityId>BUILD.L2.3.L3.3</dom:capabilityId>
    <dom:primaryFocus>Model serving, inference at scale</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_AIDataEngineering" />
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_L3.4_ModelRegistryVersioning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#L3SubCapability" />
    <rdfs:label xml:lang="en">Model Registry &amp; Versioning</rdfs:label>
    <skos:definition xml:lang="en">Centralised catalogue and lifecycle management for all ML and AI models: versioning, lineage, performance tracking, promotion gates, and deprecation across environments.</skos:definition>
    <dom:capabilityId>BUILD.L2.3.L3.4</dom:capabilityId>
    <dom:primaryFocus>Model catalogue, lifecycle governance</dom:primaryFocus>
    <dom:belongsToL2 rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#BUILD_L2.3_AIDataEngineering" />
  </rdf:Description>

  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_01_Definition"/>
    <dom:textContent>Defines, articulates, and communicates the enterprise data strategy to ensure organisational alignment and sustained executive commitment. Translates the data vision into actionable roadmaps, investment priorities, and change narratives understood by all stakeholder layers from board to operational teams.</dom:textContent>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionContent"/>
    <dom:belongsToSpecification rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1"/>
    <dom:forSection rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#Section_02_BusinessContext"/>
    <dom:textContent>Without a clearly communicated data strategy, investments fragment across siloed initiatives, business units pursue conflicting data agendas, and the data function loses credibility with executive leadership. Absence of this capability is the primary cause of data programme failure — not technical shortfall but strategic drift and misalignment.</dom:textContent>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S03_I1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dom:itemOrder>
    <dom:itemText>Vision &amp; Mission Formulation — Defining the data vision, mission statement, and long-term ambition anchored in business strategy</dom:itemText>
    <dom:relatedDimension>Strategy</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S03_I2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dom:itemOrder>
    <dom:itemText>Strategic Roadmap Development — Building phased, prioritised roadmaps translating vision into executable programmes with milestones</dom:itemText>
    <dom:relatedDimension>Process</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S03_I3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dom:itemOrder>
    <dom:itemText>Executive Narrative &amp; Business Case — Crafting compelling narratives and business cases that secure board and C-suite commitment</dom:itemText>
    <dom:relatedDimension>People</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S03_I4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dom:itemOrder>
    <dom:itemText>Cross-functional Alignment — Engaging business units, IT, finance, and operations to embed data strategy in their own planning cycles</dom:itemText>
    <dom:relatedDimension>People</dom:relatedDimension>
  </rdf:Description>
  <rdf:Description rdf:about="http://strategic-advisory.com/ontology/dom/2.0#SPEC_GOVERN_L2.1_L3.1_S03_I5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://strategic-advisory.com/ontology/dom/2.0#SectionItem"/>
    <dom:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</dom:itemOrder>
    <dom:itemText>Strategy Review &amp; Adaptation — Periodic review of strategy against market shifts, regulatory changes, and organisational maturity</dom:itemText>
    <dom:relatedDimension>Process</dom:relatedDimension>
  </rdf:Description>
